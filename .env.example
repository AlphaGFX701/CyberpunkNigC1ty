# Server-only. Never prefix these with VITE_.
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.build/neondb/auth
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional canonical origin. Leave blank for localhost / isolated Vercel preview domains.
APP_ORIGIN=
