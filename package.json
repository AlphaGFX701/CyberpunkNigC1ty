{
  "name": "techcare-signal-trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets:check && tsc -b && tsc -p tsconfig.server.json && npm run api:build && vite build",
    "api:build": "node tools/build-api.mjs",
    "assets:check": "node tools/check-runtime-assets.mjs",
    "deploy:prepare": "npm run assets:check && node tools/prepare-deploy.mjs",
    "db:migrate": "node --experimental-strip-types tools/migrate.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ui:build": "node tools/build-ui.mjs",
    "ui:export": "node tools/export-ui.mjs",
    "ui:pack": "powershell -File tools/package-ui.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@neon/auth": "0.8.2",
    "@neondatabase/serverless": "1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "codemirror": "^6.0.2",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
